FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TF_CPP_MIN_LOG_LEVEL=2

WORKDIR /app

COPY requirements-api.txt requirements-agent.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt -r requirements-agent.txt

COPY modules/ ./modules/
COPY api/ ./api/
COPY agent/ ./agent/
COPY rag/ ./rag/
COPY docs/ ./docs/
COPY models/ ./models/

RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/logs /app/chroma_db \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Rebuild the Chroma index from docs/ on every start rather than shipping a
# baked-in chroma_db/ — build_index() is idempotent (skips if /app/chroma_db
# already has data), so this is a no-op after the first start as long as
# chroma_db is on a persistent volume (see docker-compose.yml). Needs
# GOOGLE_API_KEY at container start, same as any /rag/ask request.
CMD ["sh", "-c", "python -m rag.vector_store && exec uvicorn api.main:app --host 0.0.0.0 --port 8000"]
