# Large training data — kept local, models ship pre-trained
data/parts.zip
data/parts/

# Academic deliverables and media
*.pptx
*.docx
*.pdf
*.mp4
~$*
# RAG source documents (indexed by rag/document_loader.py) stay tracked
!docs/*.docx
!docs/reports/*.docx
!docs/reports/*.pdf

# Spreadsheets (testdata.csv is the tracked sample input)
*.xlsx
*.xls
# Sample input for trying the dashboard after cloning
!data/sample/*.xlsx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Runtime
*.log
.env
logs/

# Local tooling
.claude/settings.local.json

# Generated RAG vector index (rebuilt from docs/ by rag/vector_store.py)
chroma_db/
